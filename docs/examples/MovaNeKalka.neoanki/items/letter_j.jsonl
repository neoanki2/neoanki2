{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Йому везе (повезло)", "lang": "uk"}, "ukrainian": {"text": "Йому щастить (пощастило).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
