{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Його нічого не зупинить", "lang": "uk"}, "ukrainian": {"text": "Нема йому ніякого зупинку.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Його нічого не хвилює", "lang": "uk"}, "ukrainian": {"text": "Хоч би що кому.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Його повісити мало", "lang": "uk"}, "ukrainian": {"text": "Йому й шибениці мало.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
