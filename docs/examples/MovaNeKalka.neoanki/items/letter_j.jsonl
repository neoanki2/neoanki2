{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Його й шило голить, а наша й бритва не бере", "lang": "uk"}, "ukrainian": {"text": "Одному на трісочці прядеться, а другому і веретенце не хоче.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Його не витягнеш з хати", "lang": "uk"}, "ukrainian": {"text": "Й калачем не виманиш.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Його не озадачиш", "lang": "uk"}, "ukrainian": {"text": "Його не спантеличиш.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
