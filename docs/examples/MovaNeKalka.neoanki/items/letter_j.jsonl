{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Йому до всього діло", "lang": "uk"}, "ukrainian": {"text": "Без нього і вода не освятиться.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Йому за сорок років", "lang": "uk"}, "ukrainian": {"text": "Йому понад сорок років (літ).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Йому й море по коліна", "lang": "uk"}, "ukrainian": {"text": "Йому й чорт не брат; йому хоч би що.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
