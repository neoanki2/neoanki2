{"kind": "item", "deck": "letter_j", "type": "DictionaryEntry", "fields": {"calque": {"text": "Йому виповнилося вісімнадцять років", "lang": "uk"}, "ukrainian": {"text": "Йому вийшло (минуло) вісімнадцять років (літ).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
