{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже пізно; далеко за північ", "lang": "uk"}, "ukrainian": {"text": "Після других півнів.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже пізно; несвоєчасно", "lang": "uk"}, "ukrainian": {"text": "У свинячий (у чортів) голос.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже піклуватися про кого-небудь", "lang": "uk"}, "ukrainian": {"text": "Скапувати кров’ю.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже побити кого-небудь", "lang": "uk"}, "ukrainian": {"text": "Не залишити живого місця.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже повільно говорити", "lang": "uk"}, "ukrainian": {"text": "Зимувати на кожному слові.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже повільно їхати", "lang": "uk"}, "ukrainian": {"text": "Як волами.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже повільно ходити (рухатися)", "lang": "uk"}, "ukrainian": {"text": "Ледве тягти ноги по світу; валитися від вітру.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже поганий (нікудишній)", "lang": "uk"}, "ukrainian": {"text": "Як з дишла гармата.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже покірний; слухняний", "lang": "uk"}, "ukrainian": {"text": "Як (мов, ніби) шовковий.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже порваний (пошматований) одяг", "lang": "uk"}, "ukrainian": {"text": "Дірка на дірці; латка на латці.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже посмутнів (зажурився) хтось", "lang": "uk"}, "ukrainian": {"text": "Як за стіну засунувся.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже поспішати", "lang": "uk"}, "ukrainian": {"text": "Скакати, як чорт перед хмарою.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже презирливо (гнівно) дивитися на когось", "lang": "uk"}, "ukrainian": {"text": "Спопелити очима (зором).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже приємне що-небудь комусь", "lang": "uk"}, "ukrainian": {"text": "Як маслом по душі; як медом по губах.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже принижуватися перед ким-небудь", "lang": "uk"}, "ukrainian": {"text": "Лазити (повзати) в ногах.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже прислужитися", "lang": "uk"}, "ukrainian": {"text": "Умити ноги.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже проста (легка) справа", "lang": "uk"}, "ukrainian": {"text": "Плювати діло.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже радий", "lang": "uk"}, "ukrainian": {"text": "Як слон радий.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже радіти", "lang": "uk"}, "ukrainian": {"text": "Вибрикувати гопки.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже рано", "lang": "uk"}, "ukrainian": {"text": "Ще треті півні не співали; зарання; до світ сонця.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже ретельно переглядати все", "lang": "uk"}, "ukrainian": {"text": "Перерити мишачі нори.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже розсердитися", "lang": "uk"}, "ukrainian": {"text": "Луснути з серця (зі злості).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сердитий", "lang": "uk"}, "ukrainian": {"text": "Аж булька з носа тече.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сердито (гнівно) розмовляти", "lang": "uk"}, "ukrainian": {"text": "Сипати вогнем.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно", "lang": "uk"}, "ukrainian": {"text": "Як циган на сало ласий (охочий).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно боятися", "lang": "uk"}, "ukrainian": {"text": "Як чуми боятися.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно сміятися; реготати", "lang": "uk"}, "ukrainian": {"text": "Аж за боки (за живіт) хапатися.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно, наскрізь, повністю", "lang": "uk"}, "ukrainian": {"text": "До кісток промокати (проймати, пробирати).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно; на повну силу", "lang": "uk"}, "ukrainian": {"text": "І в хвіст і в гриву.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно; у великій мірі", "lang": "uk"}, "ukrainian": {"text": "До нестями.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сильно; у найвищій мірі", "lang": "uk"}, "ukrainian": {"text": "Усіма фібрами душі (серця, істоти, нервів).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже складна справа", "lang": "uk"}, "ukrainian": {"text": "Не під силу; горішок не по зубах; гордіїв вузол; твердий (міцний) горішок.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже скромна (покірна) людина", "lang": "uk"}, "ukrainian": {"text": "Тихіший за воду, нижчий за траву.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже скупий", "lang": "uk"}, "ukrainian": {"text": "І крихти хліба не випросиш; снігу взимку не випросиш; за копійку горобця заганяє.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже слабий; жалюгідний", "lang": "uk"}, "ukrainian": {"text": "Як та хиря.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже смачний", "lang": "uk"}, "ukrainian": {"text": "Язик проковтнеш.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сміятися", "lang": "uk"}, "ukrainian": {"text": "Аж рака лазити.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сподобатися кому-небудь", "lang": "uk"}, "ukrainian": {"text": "Полонити серце.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже спокійна, лагідна, але безвольна людина", "lang": "uk"}, "ukrainian": {"text": "Боже теля.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже стара людина", "lang": "uk"}, "ukrainian": {"text": "Пісок сиплеться.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже старий, зношений, позашиваний одяг", "lang": "uk"}, "ukrainian": {"text": "Латка на латці; рубець на рубці.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже стомлений (вимучений); як вижатий лимон", "lang": "uk"}, "ukrainian": {"text": "Як викручена ганчірка.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сумлінно; з повною відповідальністю", "lang": "uk"}, "ukrainian": {"text": "Не за страх, а за совість.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже сумний; похмурий; невеселий", "lang": "uk"}, "ukrainian": {"text": "Хмара хмарою.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже схвилювався", "lang": "uk"}, "ukrainian": {"text": "Став як не свій; сам не свій; сам не при собі.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже схожі між собою в чомусь негативному", "lang": "uk"}, "ukrainian": {"text": "Одним миром мазані.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже схуднути, охлянути, виснажитися", "lang": "uk"}, "ukrainian": {"text": "Перепастися на смик.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже тихо (спокійно)", "lang": "uk"}, "ukrainian": {"text": "Немов у вусі; хоч мак сій.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже тихо, невиразно, нечітко говорити", "lang": "uk"}, "ukrainian": {"text": "Як рак у торбі шептати.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже тісно", "lang": "uk"}, "ukrainian": {"text": "Ніде голці впасти; й голки нема де кинути.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже товстий (гладкий)", "lang": "uk"}, "ukrainian": {"text": "Не втовпиться (потовпиться) в двері (в шкуру); хоч обіддя гни; метр на метр; ширший, ніж довший.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже томитися", "lang": "uk"}, "ukrainian": {"text": "Сохнути з нудоти.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже тонка кіска; жмут рідкого волосся", "lang": "uk"}, "ukrainian": {"text": "Мишачий хвіст.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже хвилювати (непокоїти)", "lang": "uk"}, "ukrainian": {"text": "Брати за живе; палити душу.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже хвилювати (тривожити)", "lang": "uk"}, "ukrainian": {"text": "Штовхнути в серце (в груди) кого.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже хитрий", "lang": "uk"}, "ukrainian": {"text": "З-під стоячого підошву випоре; підшитий лисом; лисом підшитий, псом підбитий; хитриком та шкодником підбитий; як сто китайців хитрий.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже холодно", "lang": "uk"}, "ukrainian": {"text": "І собаки не вигнати; хоч вовків (собак, псів) гони (ганяй).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже хочу їсти", "lang": "uk"}, "ukrainian": {"text": "Їсти хочу, аж душа (шкура) болить.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже худа (виснажена) людина", "lang": "uk"}, "ukrainian": {"text": "Лантух (мішок) з кістками (з маслаками).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже худий", "lang": "uk"}, "ukrainian": {"text": "Від вітру точиться.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже ціниться", "lang": "uk"}, "ukrainian": {"text": "І ціни не складе.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже часто", "lang": "uk"}, "ukrainian": {"text": "Часто-густо.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже чітко (не збиваючись) говорити (відповідати)", "lang": "uk"}, "ukrainian": {"text": "Як по писаному.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже чітко; без запинки", "lang": "uk"}, "ukrainian": {"text": "Як з книжки читати (розказувати, розповідати); як по псалтирю читати.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже чорний", "lang": "uk"}, "ukrainian": {"text": "Як сім галок.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко йти (їхати, бігти)", "lang": "uk"}, "ukrainian": {"text": "Летіти сторч головою (сторчака); аж болото за вухами скаче; без задніх ніг бігти.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко рости", "lang": "uk"}, "ukrainian": {"text": "Як гриби після дощу.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко сходити (збігати) куди-небудь", "lang": "uk"}, "ukrainian": {"text": "Одна нога тут, а друга там.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко, невідкладно робити що-небудь", "lang": "uk"}, "ukrainian": {"text": "Хапати з вогню.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко; вмить, миттю", "lang": "uk"}, "ukrainian": {"text": "Як вихор; як одна година (один день); як в’юн посолений (в ополонці, на сковороді); як води напитися; з задом наввипередки; з усіх ніг; з усього маху; як на сполох; аж вітер у вухах свище; як дощем сипле; як раз та два; у три скоки.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко; непомітно", "lang": "uk"}, "ukrainian": {"text": "Як із батога (бича) тріснув (тряснув, ляснув).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже швидко; одразу", "lang": "uk"}, "ukrainian": {"text": "Одним ударом.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже шумно (гамірно)", "lang": "uk"}, "ukrainian": {"text": "Як у вулику.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуже якісно", "lang": "uk"}, "ukrainian": {"text": "Комар носа не підточить.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Дуля з маком", "lang": "uk"}, "ukrainian": {"text": "Дірка з бублика.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Думки полізли в голову", "lang": "uk"}, "ukrainian": {"text": "Обняли думки.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_d", "type": "DictionaryEntry", "fields": {"calque": {"text": "Думки розбігаються (рояться)", "lang": "uk"}, "ukrainian": {"text": "Думка думку побиває.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
