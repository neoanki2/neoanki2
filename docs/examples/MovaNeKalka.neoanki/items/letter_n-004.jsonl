{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні в яку", "lang": "uk"}, "ukrainian": {"text": "Хоч ріж його, ані руш не хоче; хоч убий; хоч ти вмри.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні взад, ні вперед", "lang": "uk"}, "ukrainian": {"text": "Ні до ліса, ні до біса.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні від якої роботи не відмовлятися", "lang": "uk"}, "ukrainian": {"text": "За гаряче й студене хапати.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні гу-гу", "lang": "uk"}, "ukrainian": {"text": "Анічичирк, нічичирк; ні пари з вуст.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні два ні півтора", "lang": "uk"}, "ukrainian": {"text": "Ні до чобота на закаблук ні до черевика на рант; ні те ні се; ні рябе ні перісте.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні до чого не здатний", "lang": "uk"}, "ukrainian": {"text": "Ні до сака, ні до бовта.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні до чого не придатний", "lang": "uk"}, "ukrainian": {"text": "Нікудишній; як з клоччя батіг; як з телячого хвоста сито.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні душі", "lang": "uk"}, "ukrainian": {"text": "Ні лялечки; хоч би лялечка.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні єдиної душі", "lang": "uk"}, "ukrainian": {"text": "Ні [живої] душі; ні [живого] духа; ні хуху ні духу; ні лялечки; нікогісінько.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні жарко ні холодно", "lang": "uk"}, "ukrainian": {"text": "Ні гірко ні солоно; кисло мені в борщ.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні з того ні з сього", "lang": "uk"}, "ukrainian": {"text": "Ні з чого; тиць-гриць.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні за гріш", "lang": "uk"}, "ukrainian": {"text": "Ні за що ні про що.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні за що не ставити", "lang": "uk"}, "ukrainian": {"text": "Мати за ніщо (ні за що).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні за яких обставин; ніколи", "lang": "uk"}, "ukrainian": {"text": "Ніяким світом.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні за які блага", "lang": "uk"}, "ukrainian": {"text": "Нізащо у світі; ні за які гроші; хоч убий.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні за які гроші не зроблю", "lang": "uk"}, "ukrainian": {"text": "Хоч ви мене обсипте золотом – не зроблю.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні звуку, ні голосу", "lang": "uk"}, "ukrainian": {"text": "Ні пари з вуст (з рота).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні кола, ні двора", "lang": "uk"}, "ukrainian": {"text": "Вони такі убогі, що землю держалном міряють, а худобу – ложкою.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні краплі в роті", "lang": "uk"}, "ukrainian": {"text": "Ні ріски в роті.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні краплі правди", "lang": "uk"}, "ukrainian": {"text": "І ні зернини правди; і ні на мізинний ніготь правди; ні на стілечки правди.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні на йоту", "lang": "uk"}, "ukrainian": {"text": "Ані на ніготь.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні під яким видом", "lang": "uk"}, "ukrainian": {"text": "Ніколи; нізащо; у жодному разі; ні за які скарби [у світі].", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні при жодних (яких) обставинах", "lang": "uk"}, "ukrainian": {"text": "Під жодним оглядом; ні за яких умов (обставин).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні про що не турбуватися", "lang": "uk"}, "ukrainian": {"text": "На подзвін не дбати.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні про що не турбується", "lang": "uk"}, "ukrainian": {"text": "До всього байдужий (недбалий).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні разу", "lang": "uk"}, "ukrainian": {"text": "Жодного разу.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні риба ні м’ясо", "lang": "uk"}, "ukrainian": {"text": "Ні жук ні рак; ні рябе ні перісте; ні пес ні кіт; ні сюди Микита, ні туди Микита.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні світ ні зоря", "lang": "uk"}, "ukrainian": {"text": "Рано-вранці; ще й на світ не займалося (не зазоріло, не зайнялося, не благословилося); ще й не зорялося; ще й чорти навкулачки не билися.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні сіло ні пало", "lang": "uk"}, "ukrainian": {"text": "З доброго дива.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні складу ні ладу", "lang": "uk"}, "ukrainian": {"text": "І гич не до речі.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні слова з уст", "lang": "uk"}, "ukrainian": {"text": "Ні пари з уст.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні слуху ні духу", "lang": "uk"}, "ukrainian": {"text": "Ні чутки ні вістки; оце пропав, як з мосту впав.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні собі ні людям", "lang": "uk"}, "ukrainian": {"text": "І сам не гам і другому не дам.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні стати ні сісти", "lang": "uk"}, "ukrainian": {"text": "Ніде курці клюнути; ніде голкою ткнути; нема де голки (пальця) просунути (встромити).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні стиду ні совісті", "lang": "uk"}, "ukrainian": {"text": "Ні гріха ні сорому.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні сюди, ні туди", "lang": "uk"}, "ukrainian": {"text": "Ні в тин ні в ворота.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні шиє ні поре", "lang": "uk"}, "ukrainian": {"text": "Не кує й не меле.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ні шиша нема у кого", "lang": "uk"}, "ukrainian": {"text": "Нічого (нічогісінько) немає в кого.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніби знав про щось заздалегідь", "lang": "uk"}, "ukrainian": {"text": "Мов у воду дивився.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніби ошпарений", "lang": "uk"}, "ukrainian": {"text": "Мов що його впекло.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніби сам не свій", "lang": "uk"}, "ukrainian": {"text": "Мов не при собі.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нібито його не стосується", "lang": "uk"}, "ukrainian": {"text": "Наче не про нього.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нівелювати", "lang": "uk"}, "ukrainian": {"text": "Уодностайнювати, уодноманітнювати; зводити нанівець (нінащо); стирати межі.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нівечити (занапащати) життя комусь", "lang": "uk"}, "ukrainian": {"text": "Живцем топити.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нівечити факти", "lang": "uk"}, "ukrainian": {"text": "Робити з білого чорне.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніде пальцем ткнути", "lang": "uk"}, "ukrainian": {"text": "Ніде голки встромити; ніде пальця просунути.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніде робити щось", "lang": "uk"}, "ukrainian": {"text": "Хоч на лисині роби.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нізащо; ні за яких обставин", "lang": "uk"}, "ukrainian": {"text": "Ні за які гроші; ні за що на світі; ні за понюх табаки (тютюну).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нізащо; ніяк", "lang": "uk"}, "ukrainian": {"text": "Ні за яку силу.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікого не застати де-небудь", "lang": "uk"}, "ukrainian": {"text": "Поцілувати замок (двері).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікого нема", "lang": "uk"}, "ukrainian": {"text": "Ні душі.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніколи не буде", "lang": "uk"}, "ukrainian": {"text": "Буде тоді, як свині з череди йтимуть; як на долоні волосся виросте; як виросте гарбуз на вербі; як у спасівку соловейко заспіває; на Миколи та й ніколи; на святого нікди; на турецький Великдень; як рак свисне, а щука дрисне; ні тепер ні в четвер; на турецьку пасху; як півень яйце знесе; на маленького Юрія; на рахманський (брахманський) Великдень", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніколи ще цього не було", "lang": "uk"}, "ukrainian": {"text": "Зроду-віку цього не було.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікому не відомий", "lang": "uk"}, "ukrainian": {"text": "З вулиці.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікому не підходить", "lang": "uk"}, "ukrainian": {"text": "Ні на кота ні на собаку.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікуди спішити", "lang": "uk"}, "ukrainian": {"text": "Ніхто в шию не жене.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікуди; немає виходу", "lang": "uk"}, "ukrainian": {"text": "Ні назад ні вперед; ні в кут ні в двері; ні туди ні сюди; ні тпру ні ну.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікудишній", "lang": "uk"}, "ukrainian": {"text": "Нікчемний; до нічого.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікчема", "lang": "uk"}, "ukrainian": {"text": "Круглий нуль; і мізинця не варт.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нікчемний", "lang": "uk"}, "ukrainian": {"text": "Як сало без хліба.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Німеччина", "lang": "uk"}, "ukrainian": {"text": "Земля списників.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Німий; безсловесний", "lang": "uk"}, "ukrainian": {"text": "Безмовний.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нісенітниці; дурниці", "lang": "uk"}, "ukrainian": {"text": "На вербі груші.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Нісенітниця; безглуздя; дурниця", "lang": "uk"}, "ukrainian": {"text": "Сон рябої (вороної) кобили.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніскільки не страшно", "lang": "uk"}, "ukrainian": {"text": "Зовсім (анітрохи) не страшно.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніскільки; анітрохи", "lang": "uk"}, "ukrainian": {"text": "Ані (ні) краплі (крапельки краплини).", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто", "lang": "uk"}, "ukrainian": {"text": "Жоден; ані один.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто зовсім не згадає (не помітить)", "lang": "uk"}, "ukrainian": {"text": "Собака не загавкає.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто інший", "lang": "uk"}, "ukrainian": {"text": "Більше ніхто.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто інший не зможе цього зробити", "lang": "uk"}, "ukrainian": {"text": "Більше ніхто не зможе цього зробити.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто мною не командує", "lang": "uk"}, "ukrainian": {"text": "Ніхто мені не указ.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто не допускав і думки", "lang": "uk"}, "ukrainian": {"text": "Нікому близько й гадки не було.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто не знає", "lang": "uk"}, "ukrainian": {"text": "Одному Богу відомо.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто не попередив нас про небезпеку", "lang": "uk"}, "ukrainian": {"text": "Ніхто не перестеріг нас.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто нікому не зобов’язаний", "lang": "uk"}, "ukrainian": {"text": "Ніхто нікому не винен.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто тебе не змушував говорити", "lang": "uk"}, "ukrainian": {"text": "Ніхто тебе за язик не тягнув.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_n", "type": "DictionaryEntry", "fields": {"calque": {"text": "Ніхто цього не чекав", "lang": "uk"}, "ukrainian": {"text": "Ніхто цього не сподівався.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
