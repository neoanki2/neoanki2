{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куба", "lang": "uk"}, "ukrainian": {"text": "Острів свободи.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Кувейт", "lang": "uk"}, "ukrainian": {"text": "Фортеця.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
