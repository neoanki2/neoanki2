{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди б не заліз", "lang": "uk"}, "ukrainian": {"text": "Хай куди залізе.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди завгодно", "lang": "uk"}, "ukrainian": {"text": "Будь-куди; хоч куди.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди йому до тебе", "lang": "uk"}, "ukrainian": {"text": "Де куцому до зайця.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди кінь з копитом, туди й жаба з хвостом", "lang": "uk"}, "ukrainian": {"text": "Коваль коня кує, а жаба й собі ногу дає.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди кінь з копитом, туди й рак з клешнею", "lang": "uk"}, "ukrainian": {"text": "Коваль коня кує, а жаба лапу наставляє.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди Макар телят не гонив", "lang": "uk"}, "ukrainian": {"text": "Де козам роги правлять (утинають); де волам роги правлять; де кози (де кіз) кують підковами; де чорти навкулачки б’ються.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди нам", "lang": "uk"}, "ukrainian": {"text": "Де вже нашому теляті та вовка піймати.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди не глянеш", "lang": "uk"}, "ukrainian": {"text": "Де не глянь.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди не йшло", "lang": "uk"}, "ukrainian": {"text": "Ще б нічого; хай уже так.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди не кинь – всюди клин", "lang": "uk"}, "ukrainian": {"text": "Куди не кинь, а наверх дірою.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди не кинь оком", "lang": "uk"}, "ukrainian": {"text": "Куди не гляне око.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди око сягне", "lang": "uk"}, "ukrainian": {"text": "Скільки засягнути.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
