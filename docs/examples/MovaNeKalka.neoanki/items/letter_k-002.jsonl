{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди там", "lang": "uk"}, "ukrainian": {"text": "Куди ж пак.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди твої очі дивилися?", "lang": "uk"}, "ukrainian": {"text": "Де твої очі були?", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди тебе чорти занесли?", "lang": "uk"}, "ukrainian": {"text": "Пірвався, як з мотикою на сонце.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди тільки хто забажає; у всіх напрямках", "lang": "uk"}, "ukrainian": {"text": "На всі чотири.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди-небудь в інше місце", "lang": "uk"}, "ukrainian": {"text": "Деінде, десь-інде; куди-інде, кудись-інде.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куди-небудь", "lang": "uk"}, "ukrainian": {"text": "Абикуди, будь-куди, кудись, хтозна-куди.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Кудрявий", "lang": "uk"}, "ukrainian": {"text": "Кучерявий.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
