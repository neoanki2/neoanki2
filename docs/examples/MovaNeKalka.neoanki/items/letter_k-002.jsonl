{"kind": "item", "deck": "letter_k", "type": "DictionaryEntry", "fields": {"calque": {"text": "Куда", "lang": "uk"}, "ukrainian": {"text": "Куди.", "lang": "uk"}}, "tags": ["movanekalka", "ukrainian"]}
