{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoanki.app/schemas/authored-item-v6.json",
  "title": "NeoAnki authored item record",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "deck", "type", "fields"],
  "properties": {
    "kind": {"const": "item"},
    "deck": {"$ref": "#/$defs/id"},
    "type": {"$ref": "#/$defs/id"},
    "fields": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "tags": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "value": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/text"},
        {"$ref": "#/$defs/rich"},
        {"$ref": "#/$defs/number"},
        {"$ref": "#/$defs/cloze"},
        {"$ref": "#/$defs/mediaValue"},
        {"$ref": "#/$defs/imageOcclusionValue"}
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "lang": {"type": "string"}
      }
    },
    "rich": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rich"],
      "properties": {
        "rich": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/span"}
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string"},
        "styles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["bold", "italic", "underline", "strikethrough", "highlight", "code", "superscript", "subscript"]
          }
        },
        "color": {
          "enum": ["red", "orange", "yellow", "green", "mint", "teal", "cyan", "blue", "indigo", "purple", "pink", "brown", "gray"]
        },
        "size": {"enum": ["small", "large"]},
        "link": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(?:https?://(?:[^\\s/?#]+@)?(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#:]+)(?::[0-9]+)?(?:[/?#][^\\s]*)?|mailto:[^\\s]+)$",
          "$comment": "maxLength counts Unicode characters; the compiler additionally enforces a 2048 UTF-8 byte limit and parses the URL to require a non-empty HTTP(S) host or mailto path."
        }
      }
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {"number": {"type": "number"}}
    },
    "cloze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloze"],
      "properties": {"cloze": {"type": "string", "minLength": 1}}
    },
    "mediaValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media"],
      "properties": {"media": {"$ref": "#/$defs/media"}}
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^media/(?!\\.{1,2}/)(?!.*?/\\.{1,2}(?:/|$))(?:[^/]+/)*[^/]+$"
        },
        "alt": {"type": "string"},
        "durationMs": {"type": "integer", "minimum": 0}
      }
    },
    "imageOcclusionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageOcclusion"
      ],
      "properties": {
        "imageOcclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "mode",
            "masks",
            "nextGroup"
          ],
          "properties": {
            "image": {
              "$ref": "#/$defs/media",
              "required": [
                "alt"
              ]
            },
            "mode": {
              "enum": [
                "hideAllRevealOne",
                "hideOneRevealOne"
              ]
            },
            "masks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/occlusionMask"
              }
            },
            "nextGroup": {
              "type": "integer",
              "minimum": 2
            }
          },
          "$comment": "The compiler also requires a nonblank description, unique mask UUIDs, in-bounds rectangles, and nextGroup greater than every group."
        }
      }
    },
    "occlusionMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "rect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "group": {
          "type": "integer",
          "minimum": 1
        },
        "rect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "answerText": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
