{
  "manifest_version": 3,
  "name": "NeoAnki2 Companion",
  "version": "0.1.0",
  "description": "Turn selected text into a NeoAnki2 card, with suggestions from your offline dictionaries.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_title": "Add to NeoAnki2", "default_popup": "popup.html" },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*" }
}
